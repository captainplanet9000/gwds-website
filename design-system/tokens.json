{
  "$description": "GWDS design tokens — W3C Design Tokens Community Group format (draft). The source of truth for every theme layer. Other files (tokens.css, tokens.ts, Tailwind @theme) are generated from this.",
  "$meta": {
    "name": "gwds-default",
    "version": "1.0.0",
    "updated": "2026-04-22",
    "inspiration": "Raw Materials premium aesthetic — high contrast, editorial, minimal chrome."
  },

  "color": {
    "$description": "All color tokens. Canonical values are OKLCH for perceptual uniformity; #hex fallbacks live under `hex` aliases.",
    "brand": {
      "accent": {
        "$value": "oklch(0.65 0.29 295)",
        "$type": "color",
        "$description": "Primary brand accent. Used for CTAs, links on hover, focus outlines, selection background."
      },
      "accent-warm": {
        "$value": "#D4A574",
        "$type": "color",
        "$description": "Editorial warm highlight, used sparingly in marketing modules."
      },
      "electric-purple": {
        "$value": "oklch(0.65 0.29 295)",
        "$type": "color"
      },
      "deep-purple": {
        "$value": "oklch(0.58 0.32 290)",
        "$type": "color"
      },
      "light-purple": {
        "$value": "oklch(0.75 0.20 295)",
        "$type": "color"
      },
      "cyan-bright": {
        "$value": "oklch(0.75 0.15 195)",
        "$type": "color"
      },
      "cyan-deep": {
        "$value": "oklch(0.65 0.18 195)",
        "$type": "color"
      }
    },
    "surface": {
      "background": {
        "$value": "#000000",
        "$type": "color",
        "$description": "Page background."
      },
      "near-black": {
        "$value": "#050505",
        "$type": "color",
        "$description": "Elevated surface (cards, panels) — one step above background."
      },
      "card": {
        "$value": "#12121A",
        "$type": "color",
        "$description": "Card / product tile background."
      },
      "muted": {
        "$value": "#1A1A2E",
        "$type": "color",
        "$description": "Hover state and subtle fills."
      }
    },
    "border": {
      "default": {
        "$value": "rgba(232, 232, 232, 0.1)",
        "$type": "color"
      },
      "hover": {
        "$value": "rgba(232, 232, 232, 0.3)",
        "$type": "color"
      },
      "strong": {
        "$value": "oklch(0.20 0.03 260)",
        "$type": "color"
      }
    },
    "text": {
      "primary": {
        "$value": "#E8E8E8",
        "$type": "color",
        "$description": "Headings, strong body text."
      },
      "secondary": {
        "$value": "#A8A8A8",
        "$type": "color",
        "$description": "Paragraph body."
      },
      "muted": {
        "$value": "#666666",
        "$type": "color",
        "$description": "Meta, captions, disabled states."
      },
      "inverse": {
        "$value": "#000000",
        "$type": "color",
        "$description": "Text placed on a light background or an accent fill."
      }
    },
    "semantic": {
      "success": { "$value": "oklch(0.70 0.18 145)", "$type": "color" },
      "warning": { "$value": "oklch(0.75 0.20 85)",  "$type": "color" },
      "error":   { "$value": "oklch(0.65 0.25 25)",  "$type": "color" },
      "info":    { "$value": "oklch(0.70 0.15 235)", "$type": "color" }
    }
  },

  "font": {
    "family": {
      "display": {
        "$value": "Syne, 'Space Grotesk', sans-serif",
        "$type": "fontFamily",
        "$description": "Headings and any type that needs editorial character."
      },
      "body": {
        "$value": "'DM Sans', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
        "$type": "fontFamily",
        "$description": "Paragraph body, UI labels."
      },
      "mono": {
        "$value": "'JetBrains Mono', 'Fira Code', Consolas, monospace",
        "$type": "fontFamily"
      }
    },
    "weight": {
      "normal":   { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" },
      "black":    { "$value": 800, "$type": "fontWeight" }
    },
    "size": {
      "$description": "GWDS uses fluid vw-based sizes on headings for Raw-Materials-style scale. The rem scale here is for components that need stable typography (forms, tables, chips).",
      "fluid": {
        "h1": { "$value": "10vw", "$type": "dimension", "$mobile": "14vw" },
        "h2": { "$value": "6vw",  "$type": "dimension", "$mobile": "10vw" },
        "h3": { "$value": "4vw",  "$type": "dimension", "$mobile": "7vw"  },
        "h4": { "$value": "2.5vw","$type": "dimension", "$mobile": "5vw"  },
        "h5": { "$value": "1.8vw","$type": "dimension", "$mobile": "4vw"  },
        "h6": { "$value": "1.5vw","$type": "dimension", "$mobile": "3.5vw"},
        "body": { "$value": "1.2vw", "$type": "dimension", "$mobile": "4vw" },
        "btn":  { "$value": "1vw",   "$type": "dimension", "$mobile": "3.5vw" }
      },
      "static": {
        "xs":   { "$value": "0.64rem",  "$type": "dimension" },
        "sm":   { "$value": "0.8rem",   "$type": "dimension" },
        "base": { "$value": "1rem",     "$type": "dimension" },
        "lg":   { "$value": "1.25rem",  "$type": "dimension" },
        "xl":   { "$value": "1.563rem", "$type": "dimension" },
        "2xl":  { "$value": "1.953rem", "$type": "dimension" },
        "3xl":  { "$value": "2.441rem", "$type": "dimension" },
        "4xl":  { "$value": "3.052rem", "$type": "dimension" },
        "5xl":  { "$value": "3.815rem", "$type": "dimension" },
        "6xl":  { "$value": "4.768rem", "$type": "dimension" }
      }
    },
    "leading": {
      "tight":   { "$value": 1.1,  "$type": "number" },
      "snug":    { "$value": 1.375,"$type": "number" },
      "normal":  { "$value": 1.5,  "$type": "number" },
      "relaxed": { "$value": 1.7,  "$type": "number" },
      "loose":   { "$value": 2,    "$type": "number" }
    },
    "tracking": {
      "tighter": { "$value": "-0.05em", "$type": "dimension" },
      "tight":   { "$value": "-0.03em", "$type": "dimension" },
      "normal":  { "$value": "0",       "$type": "dimension" },
      "wide":    { "$value": "0.025em", "$type": "dimension" },
      "wider":   { "$value": "0.05em",  "$type": "dimension" },
      "widest":  { "$value": "0.1em",   "$type": "dimension" }
    }
  },

  "space": {
    "$description": "4px base grid up to 32, then 4-step jumps — matches the Tailwind default scale so designers can map Figma spacing 1:1.",
    "0":   { "$value": "0",       "$type": "dimension" },
    "px":  { "$value": "1px",     "$type": "dimension" },
    "0_5": { "$value": "0.125rem","$type": "dimension" },
    "1":   { "$value": "0.25rem", "$type": "dimension" },
    "2":   { "$value": "0.5rem",  "$type": "dimension" },
    "3":   { "$value": "0.75rem", "$type": "dimension" },
    "4":   { "$value": "1rem",    "$type": "dimension" },
    "5":   { "$value": "1.25rem", "$type": "dimension" },
    "6":   { "$value": "1.5rem",  "$type": "dimension" },
    "8":   { "$value": "2rem",    "$type": "dimension" },
    "10":  { "$value": "2.5rem",  "$type": "dimension" },
    "12":  { "$value": "3rem",    "$type": "dimension" },
    "16":  { "$value": "4rem",    "$type": "dimension" },
    "20":  { "$value": "5rem",    "$type": "dimension" },
    "24":  { "$value": "6rem",    "$type": "dimension" },
    "32":  { "$value": "8rem",    "$type": "dimension" },
    "fluid": {
      "$description": "Viewport-relative spacing used for hero padding and section rhythm, matching the editorial feel.",
      "xs": { "$value": "2vh", "$type": "dimension" },
      "sm": { "$value": "4vh", "$type": "dimension" },
      "md": { "$value": "8vh", "$type": "dimension" },
      "lg": { "$value": "10vh","$type": "dimension" },
      "inline-sm": { "$value": "3vw", "$type": "dimension" },
      "inline-md": { "$value": "5vw", "$type": "dimension" }
    }
  },

  "radius": {
    "none": { "$value": "0",       "$type": "dimension" },
    "sm":   { "$value": "0.375rem","$type": "dimension" },
    "md":   { "$value": "0.5rem",  "$type": "dimension" },
    "lg":   { "$value": "0.75rem", "$type": "dimension" },
    "xl":   { "$value": "1rem",    "$type": "dimension" },
    "2xl":  { "$value": "1.5rem",  "$type": "dimension" },
    "full": { "$value": "9999px",  "$type": "dimension" }
  },

  "border": {
    "width": {
      "0":    { "$value": "0",   "$type": "dimension" },
      "thin": { "$value": "1px", "$type": "dimension" },
      "med":  { "$value": "2px", "$type": "dimension" },
      "thick":{ "$value": "3px", "$type": "dimension" }
    }
  },

  "shadow": {
    "xs":  { "$value": "0 1px 2px rgba(0, 0, 0, 0.2)",  "$type": "shadow" },
    "sm":  { "$value": "0 1px 2px rgba(0, 0, 0, 0.3)",  "$type": "shadow" },
    "md":  { "$value": "0 4px 6px rgba(0, 0, 0, 0.4)",  "$type": "shadow" },
    "lg":  { "$value": "0 10px 15px rgba(0, 0, 0, 0.5)","$type": "shadow" },
    "xl":  { "$value": "0 20px 25px rgba(0, 0, 0, 0.6)","$type": "shadow" },
    "glow-accent-sm": { "$value": "0 0 20px rgba(139, 92, 246, 0.15)", "$type": "shadow" },
    "glow-accent-md": { "$value": "0 0 30px rgba(139, 92, 246, 0.25)", "$type": "shadow" },
    "glow-accent-lg": { "$value": "0 0 40px rgba(139, 92, 246, 0.35)", "$type": "shadow" }
  },

  "motion": {
    "duration": {
      "fast":   { "$value": "150ms", "$type": "duration" },
      "base":   { "$value": "200ms", "$type": "duration" },
      "slow":   { "$value": "300ms", "$type": "duration" },
      "slower": { "$value": "400ms", "$type": "duration" }
    },
    "easing": {
      "linear":  { "$value": "linear" },
      "in":      { "$value": "cubic-bezier(0.4, 0, 1, 1)" },
      "out":     { "$value": "cubic-bezier(0, 0, 0.2, 1)" },
      "in-out":  { "$value": "cubic-bezier(0.4, 0, 0.2, 1)" },
      "bounce":  { "$value": "cubic-bezier(0.68, -0.55, 0.265, 1.55)" }
    }
  },

  "z": {
    "base":           { "$value": 0,  "$type": "number" },
    "dropdown":       { "$value": 10, "$type": "number" },
    "sticky":         { "$value": 20, "$type": "number" },
    "fixed":          { "$value": 30, "$type": "number" },
    "modal-backdrop": { "$value": 40, "$type": "number" },
    "modal":          { "$value": 50, "$type": "number" },
    "popover":        { "$value": 60, "$type": "number" },
    "tooltip":        { "$value": 70, "$type": "number" },
    "toast":          { "$value": 80, "$type": "number" },
    "max":            { "$value": 999,"$type": "number" }
  },

  "breakpoint": {
    "xs": { "$value": "375px",  "$type": "dimension" },
    "sm": { "$value": "640px",  "$type": "dimension" },
    "md": { "$value": "768px",  "$type": "dimension" },
    "lg": { "$value": "1024px", "$type": "dimension" },
    "xl": { "$value": "1280px", "$type": "dimension" },
    "2xl":{ "$value": "1600px", "$type": "dimension" }
  },

  "layout": {
    "container-max": { "$value": "1600px", "$type": "dimension" },
    "container-narrow": { "$value": "1200px", "$type": "dimension" },
    "gutter":        { "$value": "5vw",    "$type": "dimension" }
  },

  "component": {
    "$description": "Semantic composites that point to primitive tokens. These are what pages should consume so primitive tweaks ripple through.",
    "button": {
      "padding-y": { "$value": "1.2vw", "$type": "dimension" },
      "padding-x": { "$value": "2.5vw", "$type": "dimension" },
      "font-size": { "$value": "{font.size.fluid.btn}", "$type": "dimension" },
      "font-family": { "$value": "{font.family.display}", "$type": "fontFamily" },
      "font-weight": { "$value": "{font.weight.semibold}", "$type": "fontWeight" },
      "border-radius": { "$value": "{radius.none}", "$type": "dimension" },
      "transition": { "$value": "all 0.3s ease" }
    },
    "card": {
      "background": { "$value": "{color.surface.card}", "$type": "color" },
      "border": { "$value": "{color.border.default}", "$type": "color" },
      "radius": { "$value": "{radius.md}", "$type": "dimension" },
      "padding": { "$value": "{space.6}", "$type": "dimension" }
    },
    "input": {
      "background": { "$value": "transparent", "$type": "color" },
      "border": { "$value": "{color.border.default}", "$type": "color" },
      "border-focus": { "$value": "{color.brand.accent}", "$type": "color" },
      "padding-y": { "$value": "{space.3}", "$type": "dimension" },
      "padding-x": { "$value": "{space.4}", "$type": "dimension" }
    }
  }
}
