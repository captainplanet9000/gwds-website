{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$name": "gwds",
  "$description": "GWDS (Gamma Waves Design Studio) design tokens, extracted from the shipped gwds.app codebase. Aesthetic: editorial-minimalist black canvas (Raw Materials inspired) with an electric-purple accent layer for hero, CTA, and brand moments.",
  "$version": "1.0.0",

  "color": {
    "background": {
      "canvas":      { "$value": "#000000",                  "$description": "Root page background. Pure black." },
      "near":        { "$value": "#050505",                  "$description": "One step up from canvas, for layered surfaces." },
      "surface":     { "$value": "rgba(255,255,255,0.03)",   "$description": "Subtle elevated surface (inputs, secondary buttons, cards on black)." },
      "surfaceGlass":{ "$value": "rgba(18,18,26,0.8)",       "$description": "Glass card fill — pair with backdrop-filter blur." },
      "overlay":     { "$value": "rgba(0,0,0,0.5)",          "$description": "Modal/drawer backdrop, top vignette gradients." }
    },
    "text": {
      "primary": { "$value": "#E8E8E8", "$description": "Body default, headings. Never pure white." },
      "muted":   { "$value": "#A8A8A8", "$description": "Secondary copy, labels, descriptions." },
      "dim":     { "$value": "#666666", "$description": "Tertiary text, metadata, scroll hints." },
      "faint":   { "$value": "#555555", "$description": "Near-invisible hints (scroll indicator lines)." },
      "headline":{ "$value": "#F0ECF9", "$description": "Hero headline tint — slight cool cast on top of #E8E8E8." },
      "onAccent":{ "$value": "#FFFFFF", "$description": "Text on purple fills." },
      "onInvert":{ "$value": "#000000", "$description": "Text when background inverts to #E8E8E8 (button hover)." }
    },
    "border": {
      "default":{ "$value": "rgba(232,232,232,0.1)", "$description": "Default hairline border on black." },
      "hover":  { "$value": "rgba(232,232,232,0.3)", "$description": "Hover/focus border." },
      "accent": { "$value": "rgba(139,92,246,0.3)",  "$description": "Purple-tinted border for accent pills and glowing CTAs." }
    },
    "accent": {
      "purple": {
        "base":   { "$value": "#8B5CF6", "$description": "Primary brand purple. Use for single-color fills, icons, small highlights." },
        "deep":   { "$value": "#7C3AED", "$description": "Gradient start, pressed states." },
        "light":  { "$value": "#A78BFA", "$description": "Gradient mid, hover tints, secondary highlights." },
        "pale":   { "$value": "#C084FC", "$description": "Gradient end, headline text-fill mid-stop." },
        "oklch":  { "$value": "oklch(0.65 0.29 295)", "$description": "Canonical OKLCH equivalent of `purple.base`. Prefer this in new CSS." },
        "softBg": { "$value": "rgba(139,92,246,0.08)", "$description": "Tagline pill / glass-tinted surface." },
        "softBg2":{ "$value": "rgba(139,92,246,0.1)",  "$description": "Radial glow wash center." }
      },
      "warm":  { "$value": "#D4A574", "$description": "Warm gold — editorial secondary accent, sparing use." }
    },
    "spectrum": {
      "$description": "OKLCH hues used for per-product / per-category tints in Featured, Category, Newsletter sections. Always same lightness neighborhood so they balance on black.",
      "purple": { "$value": "oklch(0.65 0.29 295)" },
      "cyan":   { "$value": "oklch(0.75 0.15 195)" },
      "green":  { "$value": "oklch(0.70 0.18 145)" },
      "gold":   { "$value": "oklch(0.82 0.18 85)"  },
      "pink":   { "$value": "oklch(0.70 0.25 340)" }
    },
    "semantic": {
      "success": { "$value": "#10B981" },
      "warning": { "$value": "#F59E0B" },
      "danger":  { "$value": "#EC4899", "$description": "Magenta-red used for destructive admin actions." },
      "info":    { "$value": "#06B6D4" }
    }
  },

  "font": {
    "family": {
      "display":{ "$value": "'Syne', sans-serif",              "$description": "All headings (h1-h6), logo, CTA button labels. Weights 600-800." },
      "body":   { "$value": "'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif", "$description": "Paragraph, nav, inputs, generic UI." },
      "mono":   { "$value": "'JetBrains Mono', 'Fira Code', Consolas, monospace", "$description": "Reserved for code, ticker/price display, terminal aesthetic." }
    },
    "weight": {
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 },
      "black":    { "$value": 800 }
    },
    "size": {
      "$description": "Fluid type. Prefer clamp() in components; the vw values below mirror globals.css and should be treated as upper bounds. Mobile (<768px) falls back to the rem values.",
      "h1":    { "$value": "clamp(2.2rem, 10vw, 9rem)" },
      "h2":    { "$value": "clamp(1.6rem, 6vw, 5rem)"  },
      "h3":    { "$value": "clamp(1.3rem, 4vw, 3rem)"  },
      "h4":    { "$value": "clamp(1.1rem, 2.5vw, 2rem)" },
      "h5":    { "$value": "clamp(1rem, 1.8vw, 1.4rem)" },
      "h6":    { "$value": "clamp(0.9rem, 1.5vw, 1.1rem)" },
      "body":  { "$value": "clamp(0.95rem, 1.2vw, 1.125rem)" },
      "small": { "$value": "0.82rem" },
      "micro": { "$value": "0.6rem", "$description": "Eyebrow/overline labels. Always paired with uppercase + letterSpacing.wider." }
    },
    "lineHeight": {
      "tight":   { "$value": 1.1,  "$description": "Headings." },
      "snug":    { "$value": 1.375 },
      "normal":  { "$value": 1.6,  "$description": "Body default." },
      "relaxed": { "$value": 1.7,  "$description": "Long-form paragraphs, subtitles." }
    },
    "letterSpacing": {
      "tightest":{ "$value": "-0.03em", "$description": "Headings (Syne). Non-negotiable." },
      "tight":   { "$value": "-0.02em" },
      "normal":  { "$value": "0" },
      "wide":    { "$value": "0.06em", "$description": "Uppercase CTAs." },
      "wider":   { "$value": "0.15em", "$description": "Eyebrow labels, small uppercase tags." },
      "widest":  { "$value": "0.2em",  "$description": "Scroll indicator, ultra-small uppercase." }
    }
  },

  "space": {
    "$description": "Two scales coexist. Use `fluid` for section rhythm (full-bleed layouts, hero verticality) and `fixed` for component internals (padding, gap inside buttons/cards).",
    "fluid": {
      "xs": { "$value": "2vh" },
      "sm": { "$value": "4vh" },
      "md": { "$value": "8vh" },
      "lg": { "$value": "10vh", "$description": "Vertical padding of full-viewport sections." },
      "pageGutter": { "$value": "5vw", "$description": "Horizontal page padding for .container." }
    },
    "fixed": {
      "0": { "$value": "0" },
      "1": { "$value": "4px"  },
      "2": { "$value": "8px"  },
      "3": { "$value": "12px" },
      "4": { "$value": "16px" },
      "5": { "$value": "20px" },
      "6": { "$value": "24px" },
      "8": { "$value": "32px" },
      "10":{ "$value": "40px" },
      "12":{ "$value": "48px" },
      "16":{ "$value": "64px" }
    }
  },

  "layout": {
    "container": {
      "wide":   { "$value": "1600px", "$description": ".container max-width." },
      "narrow": { "$value": "1200px", "$description": ".container-narrow max-width." },
      "prose":  { "$value": "700px",  "$description": "Hero text block max-width." }
    },
    "section": {
      "full":  { "$value": "100vh", "$description": "Hero / statement sections." },
      "half":  { "$value": "50vh" }
    },
    "breakpoint": {
      "sm":  { "$value": "640px"  },
      "md":  { "$value": "768px",  "$description": "Mobile/desktop switch — site's primary breakpoint." },
      "lg":  { "$value": "1024px" },
      "xl":  { "$value": "1280px" },
      "2xl": { "$value": "1920px", "$description": "Ultra-wide body-text downscale trigger." }
    }
  },

  "radius": {
    "none":  { "$value": "0" },
    "xs":    { "$value": "4px",  "$description": "Category badges, scrollbar." },
    "sm":    { "$value": "8px",  "$description": "Primary buttons, compact cards, close icons." },
    "md":    { "$value": "10px", "$description": "Inputs, medium CTAs." },
    "lg":    { "$value": "12px", "$description": "Input fields, badges, nested cards." },
    "xl":    { "$value": "16px", "$description": "Feature cards, Hero primary panels." },
    "pill":  { "$value": "999px","$description": "Tagline pills, status chips. Always full-round." }
  },

  "shadow": {
    "none":      { "$value": "none" },
    "sm":        { "$value": "0 2px 8px rgba(0,0,0,0.2)" },
    "md":        { "$value": "0 4px 12px rgba(0,0,0,0.4)" },
    "lg":        { "$value": "0 20px 60px rgba(0,0,0,0.4)" },
    "glowSm":    { "$value": "0 0 20px rgba(139,92,246,0.25)", "$description": "Resting state of primary purple button." },
    "glowMd":    { "$value": "0 0 30px rgba(139,92,246,0.4)",  "$description": "Hover state of primary purple button." },
    "glowLg":    { "$value": "0 20px 60px rgba(139,92,246,0.1), 0 8px 24px rgba(0,0,0,0.4)", "$description": "Featured product card hover lift." },
    "glowOklch": { "$value": "0 0 8px oklch(0.65 0.29 295 / 0.8)", "$description": "Scroll progress bar, OKLCH glow variant." }
  },

  "gradient": {
    "headline":      { "$value": "linear-gradient(135deg, #8B5CF6, #C084FC, #A78BFA)", "$description": "Apply with -webkit-background-clip:text for headline highlight spans." },
    "buttonPrimary": { "$value": "linear-gradient(135deg, #7C3AED, #8B5CF6)",          "$description": "Primary CTA fill." },
    "buttonOklch":   { "$value": "linear-gradient(135deg, oklch(0.65 0.29 295), oklch(0.75 0.15 195))", "$description": "Purple→cyan CTA used in Newsletter." },
    "heroWash":      { "$value": "radial-gradient(ellipse 70% 55% at 50% 35%, rgba(139,92,246,0.1) 0%, rgba(124,58,237,0.03) 40%, transparent 70%)", "$description": "Center-weighted purple background wash behind Hero." },
    "sectionWash":   { "$value": "radial-gradient(ellipse 70% 80% at 50% 50%, oklch(0.65 0.29 295 / 0.12), transparent 70%)", "$description": "Softer section wash for non-hero sections (Newsletter)." },
    "bottomFade":    { "$value": "linear-gradient(to bottom, transparent, #000)", "$description": "Section-to-black transition." },
    "topVignette":   { "$value": "linear-gradient(to bottom, rgba(0,0,0,0.5), transparent)", "$description": "Top darkening for hero readability." }
  },

  "effect": {
    "blur": {
      "subtle":   { "$value": "blur(4px)",  "$description": "Drawer/modal backdrop." },
      "standard": { "$value": "blur(8px)",  "$description": "Glass buttons, tagline pills, secondary surfaces." },
      "heavy":    { "$value": "blur(20px)", "$description": "Sticky navbar, featured glass cards." }
    },
    "noiseOverlay": {
      "$value": "url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E\")",
      "$description": "Fixed full-viewport noise at opacity 0.02, mix-blend-mode overlay. Applied once on body::before."
    }
  },

  "motion": {
    "duration": {
      "instant": { "$value": "150ms" },
      "fast":    { "$value": "200ms" },
      "base":    { "$value": "300ms", "$description": "Default transition on links, borders." },
      "slow":    { "$value": "800ms", "$description": "Scale-in keyframe." },
      "slower":  { "$value": "1000ms","$description": "Fade-in keyframe." },
      "slowest": { "$value": "1200ms","$description": "Hero fade-in-up keyframe." }
    },
    "easing": {
      "linear": { "$value": "linear" },
      "in":     { "$value": "cubic-bezier(0.4, 0, 1, 1)" },
      "out":    { "$value": "cubic-bezier(0, 0, 0.2, 1)", "$description": "Default for entrances." },
      "inOut":  { "$value": "cubic-bezier(0.4, 0, 0.2, 1)" }
    },
    "keyframes": {
      "fadeIn":   "opacity 0→1, translateY 30px → 0",
      "fadeInUp": "opacity 0→1, translateY 60px → 0",
      "scaleIn":  "opacity 0→1, scale 0.95 → 1"
    },
    "stagger": { "$value": "100ms", "$description": "Delay between sibling reveals (.delay-100 → .delay-600)." },
    "reducedMotion": "All animation/transition durations collapse to 0.01ms under prefers-reduced-motion."
  },

  "z": {
    "base":      { "$value": 0  },
    "dropdown":  { "$value": 10 },
    "sticky":    { "$value": 20 },
    "fixed":     { "$value": 30 },
    "overlay":   { "$value": 40 },
    "modal":     { "$value": 50 },
    "popover":   { "$value": 60 },
    "tooltip":   { "$value": 70 },
    "toast":     { "$value": 80 },
    "navbar":    { "$value": 10000, "$description": "Navbar forced above 3D canvases and Lenis smooth-scroll layers." }
  }
}
