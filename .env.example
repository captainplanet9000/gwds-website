# Public site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_SALES_ENABLED=false
NEXT_PUBLIC_HOSTING_SALES_ENABLED=false

# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (use test-mode values for development)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_CORE_STRIPE_PRICE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# Transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_EMAIL=
# Where /api/cron/hosting-provision-watch alerts on a paid-signup tenant whose provisioning
# failed. Falls back to SUPPORT_EMAIL when unset.
HOSTING_OPS_ALERT_EMAIL=

# Admin sessions and signing secrets (use independent random values)
# Admin identity uses verified Supabase Auth + enrolled TOTP + the admin_members table.
GWDS_ADMIN_SESSION_SECRET=
CIVAL_RATE_LIMIT_SECRET=
NEWSLETTER_SIGNING_SECRET=

# Reverse-proxy gateway (C:/GWDS/hosting/services/gateway) — customer "open my live dashboard"
# links. GATEWAY_TICKET_SECRET MUST equal the gateway's own GATEWAY_TICKET_SECRET (32+ random
# bytes; generate with `openssl rand -base64 32`); GATEWAY_BASE_DOMAIN must equal its
# GATEWAY_BASE_DOMAIN. See src/app/api/account/dashboard-link/route.ts and
# C:/GWDS/hosting/services/gateway/README.md.
GATEWAY_TICKET_SECRET=
GATEWAY_BASE_DOMAIN=

# Managed paper-hosting automation. Keep disabled until a dedicated scoped token
# is installed and the full provision/backup/recovery drill passes.
HOSTING_AUTOMATION_ENABLED=false
VERCEL_HOSTING_AUTOMATION_TOKEN=
VERCEL_HOSTING_TEAM_ID=
CIVAL_CORE_GITHUB_REPO=
CIVAL_CORE_GITHUB_REPO_ID=
CIVAL_CORE_GIT_REF=main
CRON_SECRET=

# Non-custodial funding + agent-approval (/account/funding, src/app/api/account/funding/*).
# Network selection mirrors the live trading dashboard's own fail-safe default: unset = testnet.
NEXT_PUBLIC_HYPERLIQUID_NETWORK=testnet
# Read-only Arbitrum RPC for balance checks. Public defaults are used if unset; set your own for
# reliability (Alchemy/Infura/etc — read-only key, never a signing key).
ARBITRUM_RPC_URL=
# The Hyperliquid Arbitrum bridge contract. Deliberately left unset by default — a USDC transfer
# to the wrong address is unrecoverable, so the funding page shows "not configured" rather than
# ever guessing this value. Set only from Hyperliquid's own published bridge address.
HYPERLIQUID_BRIDGE_ADDRESS=
# WalletConnect Cloud project id (cloud.walletconnect.com) for the wallet-connect QR flow.
# Injected wallets (MetaMask, Rabby, etc.) work without this; only WalletConnect needs it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Secret for the stateless wallet-ownership-proof challenge (32+ random bytes). Required for
# /api/account/funding/verify-wallet to function — generate with `openssl rand -base64 32`.
WALLET_CHALLENGE_SECRET=
